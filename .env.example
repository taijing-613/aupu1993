# 复制为 .env 并填入你的 Key（.env 已被 .gitignore 忽略，不会入库）
#
# AI 视觉大模型比对（OpenAI 兼容接口，默认 GPT-4V / gpt-4o）
# 这是唯一需要在这里配置的敏感项；base_url / 模型名在「项目设置」页面里配置（入库的是非敏感配置）。
VISION_API_KEY=sk-your-key-here

# 可选：若使用其他兼容服务（通义千问VL / 腾讯混元 / Azure / 本地 vLLM），
# 需同时修改「项目设置」页面的 API Base URL 与模型名：
#   VISION_BASE_URL=https://api.openai.com/v1
#   VISION_MODEL=gpt-4o
